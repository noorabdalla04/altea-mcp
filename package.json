{
  "name": "altea-mcp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Personal MCP server + CLI for the Altea Active (myaltea.app) booking app: schedules, spots, instructors, bookings, cancellations, waitlists.",
  "bin": {
    "altea": "bin/altea.mjs"
  },
  "main": "src/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "node bin/mcp-server.mjs",
    "login": "node bin/altea.mjs login",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "eval": "node scripts/eval.mjs",
    "install-claude": "bash scripts/install.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.59.1",
    "zod": "^3.24.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noorabdalla04/altea-mcp.git"
  },
  "homepage": "https://github.com/noorabdalla04/altea-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "altea",
    "gym",
    "booking",
    "claude"
  ]
}
